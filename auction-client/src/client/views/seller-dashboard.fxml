<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="main-bg" stylesheets="@app.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.SellerDashboardController">
    <left>
        <VBox prefWidth="260.0" styleClass="sidebar">
            <padding><Insets top="20.0" bottom="20.0"/></padding>
            <Label text="AuctionVN Seller" textFill="WHITE">
                <font><Font name="System Bold" size="24.0" /></font>
                <VBox.margin><Insets bottom="30.0" left="20.0" right="20.0" /></VBox.margin>
            </Label>

            <Button maxWidth="Infinity" text="📦 Quản lý sản phẩm" styleClass="sidebar-btn, sidebar-btn-active" />
            <Button maxWidth="Infinity" onAction="#showAddProductDialog" text="➕ Đăng bán mới" styleClass="sidebar-btn" />
            <Button maxWidth="Infinity" text="📊 Báo cáo doanh thu" styleClass="sidebar-btn" />

            <Pane VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#handleLogout" text="🚪 Đăng xuất" styleClass="sidebar-btn" style="-fx-text-fill: #ef4444;" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Quản lý kho hàng"><font><Font name="System Bold" size="26.0" /></font></Label>
                <Pane HBox.hgrow="ALWAYS" />

                <Button onAction="#handleDeleteProduct" text="🗑 Xóa" styleClass="btn-danger" />
                <Button onAction="#handleEditProduct" text="✏️ Sửa" styleClass="btn-info" />
                <Button onAction="#showAddProductDialog" text="+ Thêm Mới" styleClass="btn-success" />
            </HBox>

            <TableView fx:id="tableItems" VBox.vgrow="ALWAYS" styleClass="table-view-custom">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                    <TableColumn fx:id="colName" prefWidth="300" text="Tên sản phẩm" />
                    <TableColumn fx:id="colPrice" prefWidth="150" text="Giá hiện tại" />
                    <TableColumn fx:id="colWinner" prefWidth="150" text="Người dẫn đầu" />
                    <TableColumn fx:id="colStatus" prefWidth="150" text="Trạng thái" />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>