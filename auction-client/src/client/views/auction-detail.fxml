<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>

<StackPane stylesheets="@app.css" xmlns="http://javafx.com/javafx/17.0.2-ea"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.controllers.AuctionDetailController">

    <VBox spacing="0" styleClass="main-bg">

        <!-- Top bar -->
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: white; -fx-padding: 14 24; -fx-border-color: transparent transparent #E2E8F0 transparent; -fx-border-width: 1;">
            <Button text="⬅  Quay lại" onAction="#handleBackToList"
                    style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 16;"/>
            <Label text="⚡" style="-fx-font-size: 20px;"/>
            <VBox spacing="1">
                <Label fx:id="lblRoomTitle" text="Đấu giá trực tiếp"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                <Label fx:id="lblRoomId" text="Phòng #--"
                       style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblStatusBadge" text="● Đang chạy"
                   style="-fx-background-color: #ECFDF5; -fx-text-fill: #059669; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 4 12; -fx-background-radius: 20;"/>
        </HBox>

        <!-- Main 2-column layout -->
        <HBox spacing="16" VBox.vgrow="ALWAYS">
            <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

            <!-- Col 1: Giá + Đặt giá + Biểu đồ -->
            <VBox spacing="14" HBox.hgrow="ALWAYS">

                <!-- Giá + Timer -->
                <HBox spacing="14">
                    <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label text="GIÁ HIỆN TẠI"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblCurrentPrice" text="Đang tải..."
                               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                        <Label fx:id="lblWinner" text="👤 Người dẫn đầu: --"
                               style="-fx-font-size: 13px; -fx-text-fill: #2563EB;"/>
                    </VBox>
                    <VBox styleClass="card" spacing="6" prefWidth="175" alignment="CENTER">
                        <Label text="THỜI GIAN CÒN LẠI"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblTimer" text="--:--:--"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #EF4444;"/>
                    </VBox>
                </HBox>

                <!-- Đặt giá thủ công -->
                <VBox styleClass="card" spacing="12">
                    <Label text="Đặt giá thủ công"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                    <HBox spacing="10">
                        <TextField fx:id="txtBidAmount" promptText="Nhập số tiền..."
                                   prefHeight="44" HBox.hgrow="ALWAYS"
                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #CBD5E1; -fx-padding: 0 14;"/>
                        <Button fx:id="btnPlaceBid" text="🔨  Đặt giá" onAction="#handlePlaceBid"
                                prefHeight="44"
                                style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 20;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Tăng nhanh:" style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                        <Button text="+500k" onAction="#handleQuickBid" userData="500000"
                                style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 12;"/>
                        <Button text="+1tr" onAction="#handleQuickBid" userData="1000000"
                                style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 12;"/>
                        <Button text="+2tr" onAction="#handleQuickBid" userData="2000000"
                                style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 12;"/>
                        <Button text="+5tr" onAction="#handleQuickBid" userData="5000000"
                                style="-fx-background-color: #F1F5F9; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnOpenAutoBid" text="🤖  Cài AutoBid" onAction="#handleOpenAutoBidDialog"
                                style="-fx-background-color: #EFF6FF; -fx-text-fill: #1D4ED8; -fx-border-color: #BFDBFE; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 8 16;"/>
                    </HBox>

                    <!-- AutoBid status bar -->
                    <HBox fx:id="paneAutoBidActive" spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: #ECFDF5; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #6EE7B7; -fx-border-radius: 8;"
                          managed="false" visible="false">
                        <Label text="🤖" style="-fx-font-size: 15px;"/>
                        <VBox spacing="2">
                            <Label text="AutoBid đang hoạt động"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #065F46;"/>
                            <Label fx:id="lblAutoBidInfo" text="Giới hạn: -- · Bước: -- · Chế độ: --"
                                   style="-fx-font-size: 11px; -fx-text-fill: #059669;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Hủy" onAction="#handleCancelAutoBid"
                                style="-fx-background-color: #FEF2F2; -fx-text-fill: #EF4444; -fx-border-color: #FCA5A5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 5 12;"/>
                    </HBox>
                </VBox>

                <!-- Biểu đồ + lịch sử -->
                <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                    <Label text="Diễn biến đấu giá"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
                             style="-fx-background-color: transparent; -fx-border-color: #E2E8F0;">
                        <Tab text="📈 Biểu đồ giá">
                            <LineChart fx:id="bidHistoryChart" animated="true" legendVisible="false"
                                       style="-fx-padding: 8;">
                                <xAxis><CategoryAxis label="Lượt đặt" animated="false"/></xAxis>
                                <yAxis><NumberAxis label="VNĐ" animated="false"/></yAxis>
                            </LineChart>
                        </Tab>
                        <Tab text="📄 Lịch sử chi tiết">
                            <ListView fx:id="historyList"
                                      style="-fx-background-color: #F8FAFC; -fx-border-color: transparent;"/>
                        </Tab>
                    </TabPane>
                </VBox>
            </VBox>

            <!-- Col 2: User Profile + Bid của tôi -->
            <VBox spacing="14" prefWidth="290">

                <!-- Hồ sơ người dùng -->
                <VBox styleClass="card" spacing="14">
                    <!-- Avatar + tên -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label fx:id="lblAvatar" text="??"
                               style="-fx-background-color: #DBEAFE; -fx-text-fill: #1E40AF; -fx-font-weight: bold; -fx-font-size: 18px; -fx-background-radius: 26; -fx-min-width: 52; -fx-max-width: 52; -fx-min-height: 52; -fx-max-height: 52; -fx-alignment: center;"/>
                        <VBox spacing="3">
                            <Label fx:id="lblProfileName" text="--"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                            <Label fx:id="lblProfileRole" text="Người đấu giá"
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                        </VBox>
                    </HBox>

                    <!-- 4 stats dạng lưới 2x2 -->
                    <GridPane hgap="8" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox styleClass="stat-card stat-green" spacing="3"
                              GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-padding: 10;">
                            <Label text="Số dư ví" styleClass="stat-title"/>
                            <Label fx:id="lblProfileBalance" text="--"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                        </VBox>
                        <VBox styleClass="stat-card stat-blue" spacing="3"
                              GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-padding: 10;">
                            <Label text="Lần bid" styleClass="stat-title"/>
                            <Label fx:id="lblProfileBidCount" text="0"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E40AF;"/>
                        </VBox>
                        <VBox styleClass="stat-card stat-orange" spacing="3"
                              GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-padding: 10;">
                            <Label text="Phiên thắng" styleClass="stat-title"/>
                            <Label fx:id="lblProfileWins" text="--"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #B45309;"/>
                        </VBox>
                        <VBox styleClass="stat-card stat-purple" spacing="3"
                              GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-padding: 10;">
                            <Label text="Tỉ lệ thắng" styleClass="stat-title"/>
                            <Label fx:id="lblProfileWinRate" text="--"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #6D28D9;"/>
                        </VBox>
                    </GridPane>

                    <!-- Rank badge -->
                    <HBox spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: #FFFBEB; -fx-background-radius: 8; -fx-padding: 10 14; -fx-border-color: #FDE68A; -fx-border-radius: 8;">
                        <Label fx:id="lblRankIcon" text="🥇" style="-fx-font-size: 20px;"/>
                        <VBox spacing="1">
                            <Label fx:id="lblRankTitle" text="--"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #92400E;"/>
                            <Label fx:id="lblRankSub" text="--"
                                   style="-fx-font-size: 11px; -fx-text-fill: #B45309;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Lịch sử bid của tôi -->
                <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Lịch sử bid của tôi"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblMyBestBid" text=""
                               style="-fx-font-size: 11px; -fx-text-fill: #059669; -fx-font-weight: bold;"/>
                    </HBox>
                    <ListView fx:id="myBidHistoryList"
                              style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS"/>
                </VBox>

            </VBox>
        </HBox>
    </VBox>

    <!-- Overlay kết thúc -->
    <VBox fx:id="overlayFinished" visible="false" alignment="CENTER"
          style="-fx-background-color: rgba(0,0,0,0.75);">
        <VBox alignment="CENTER" spacing="16"
              style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 20, 0, 0, 0);"
              maxWidth="480" maxHeight="300">
            <Label fx:id="lblFinishIcon" text="🏆" style="-fx-font-size: 56px;"/>
            <Label fx:id="lblFinishTitle" text="CHÚC MỪNG!"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label fx:id="lblFinishMessage" text="Đang tải..." wrapText="true"
                   style="-fx-font-size: 15px; -fx-text-fill: #475569;" alignment="CENTER"/>
            <Button text="Quay lại danh sách" onAction="#handleBackToList" styleClass="btn-primary"
                    style="-fx-padding: 10 32;"/>
        </VBox>
    </VBox>
</StackPane>
