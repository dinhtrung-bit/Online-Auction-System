<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="720.0" prefWidth="1120.0" styleClass="auth-bg" stylesheets="@app.css"
           xmlns="http://javafx.com/javafx/17.0.2-ea"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.controllers.LoginController">

    <HBox maxWidth="1040" maxHeight="640" styleClass="auth-shell">
        <VBox prefWidth="470" alignment="CENTER_LEFT" spacing="28" styleClass="auth-hero">
            <padding><Insets top="56" right="46" bottom="56" left="46"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="brand-icon-large" prefWidth="56" prefHeight="56">
                    <Label text="⚡" style="-fx-font-size: 28px;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="AuctionVN" textFill="WHITE"><font><Font name="System Bold" size="32"/></font></Label>
                    <Label text="Realtime Online Auction" styleClass="auth-hero-subtitle"/>
                </VBox>
            </HBox>

            <VBox spacing="10">
                <Label text="Đấu giá trực tuyến" styleClass="auth-hero-title"/>
                <Label text="Quản lý phiên đấu giá, ví điện tử, sản phẩm và người dùng trên cùng một hệ thống." styleClass="auth-hero-desc" wrapText="true"/>
            </VBox>

            <VBox spacing="12">
                <Label text="✓ Đấu giá thời gian thực" styleClass="auth-feature"/>
                <Label text="✓ Tách quyền Admin / Seller / Bidder" styleClass="auth-feature"/>
                <Label text="✓ Giao dịch nhanh,gọn,tiện lợi." styleClass="auth-feature"/>
            </VBox>
        </VBox>

        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <VBox alignment="CENTER_LEFT" maxWidth="440" spacing="20" styleClass="auth-card">
                <padding><Insets top="42" right="42" bottom="42" left="42"/></padding>

                <VBox spacing="6">
                    <Label text="Đăng nhập" styleClass="auth-title"/>
                    <Label text="Chọn vai trò và nhập thông tin tài khoản" styleClass="auth-subtitle"/>
                </VBox>

                <VBox spacing="9">
                    <Label text="Bạn là ai?" styleClass="form-label"/>
                    <HBox spacing="10" alignment="CENTER">
                        <Button fx:id="btnAdmin" onAction="#selectAdmin" prefHeight="44" prefWidth="118" text="Admin" styleClass="role-button"/>
                        <Button fx:id="btnSeller" onAction="#selectSeller" prefHeight="44" prefWidth="118" text="Người bán" styleClass="role-button"/>
                        <Button fx:id="btnBidder" onAction="#selectBidder" prefHeight="44" prefWidth="118" text="Người mua" styleClass="role-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="9">
                    <Label text="Tên đăng nhập" styleClass="form-label"/>
                    <TextField fx:id="txtUsername" prefHeight="46" promptText="Nhập username..." styleClass="input-field"/>
                </VBox>

                <VBox spacing="9">
                    <Label text="Mật khẩu" styleClass="form-label"/>
                    <PasswordField fx:id="txtPassword" onAction="#handleLogin" prefHeight="46" promptText="Nhập mật khẩu..." styleClass="input-field"/>
                </VBox>

                <Button maxWidth="Infinity" onAction="#handleLogin" prefHeight="50" styleClass="btn-primary" text="ĐĂNG NHẬP"/>

                <HBox alignment="CENTER" spacing="5">
                    <Label text="Chưa có tài khoản?" styleClass="text-muted"/>
                    <Hyperlink onAction="#goToRegister" styleClass="hyperlink" text="Đăng ký ngay"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
