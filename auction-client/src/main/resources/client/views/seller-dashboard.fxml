<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="main-bg" stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controllers.SellerDashboardController">

    <!-- ══════════════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="240" spacing="4"
              style="-fx-background-color: #0F172A; -fx-padding: 0 0 20 0;">

            <!-- Brand -->
            <VBox style="-fx-padding: 24 20 20 20;
                         -fx-border-color: transparent transparent #1E293B transparent;
                         -fx-border-width: 1;">
                <Label text="⚡ AuctionVN"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Seller Dashboard"
                       style="-fx-font-size: 11px; -fx-text-fill: #475569; -fx-padding: 3 0 0 0;"/>
            </VBox>

            <VBox spacing="2" style="-fx-padding: 12 10 0 10;">
                <Button fx:id="btnInventory" maxWidth="Infinity"
                        onAction="#handleShowInventory" text="📦  Kho hàng"
                        styleClass="sidebar-btn sidebar-btn-active"/>
                <Button maxWidth="Infinity"
                        onAction="#showAddProductDialog" text="＋  Đăng sản phẩm mới"
                        styleClass="sidebar-btn"/>
                <Button maxWidth="Infinity"
                        onAction="#handleStartAuction" text="🔨  Tạo phiên đấu giá"
                        styleClass="sidebar-btn"/>
                <Button fx:id="btnReport" maxWidth="Infinity"
                        onAction="#handleShowReport" text="📊  Báo cáo doanh thu"
                        styleClass="sidebar-btn"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox style="-fx-padding: 0 10;">
                <Button maxWidth="Infinity" onAction="#handleLogout" text="→  Đăng xuất"
                        styleClass="sidebar-btn"
                        style="-fx-text-fill: #EF4444; -fx-background-color: transparent;
                               -fx-alignment: center-left; -fx-padding: 12 20;
                               -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-background-radius: 10;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════
         MAIN CONTENT
    ══════════════════════════════════════════════ -->
    <center>
        <StackPane style="-fx-background-color: #F8FAFC;">

            <!-- ── VIEW 1: KHO HÀNG ─────────────────────── -->
            <VBox fx:id="inventoryView" spacing="0">

                <!-- Page header -->
                <VBox style="-fx-padding: 26 30 20 30; -fx-background-color: #F8FAFC;
                             -fx-border-color: transparent transparent #E2E8F0 transparent;
                             -fx-border-width: 1;" spacing="4">
                    <Label text="Quản lý kho hàng"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                    <Label text="Theo dõi sản phẩm và trạng thái các phiên đấu giá của bạn"
                           style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
                </VBox>

                <!-- Toolbar -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding: 16 30; -fx-background-color: white;
                             -fx-border-color: transparent transparent #F1F5F9 transparent;
                             -fx-border-width: 1;">
                    <Button onAction="#showAddProductDialog" text="＋  Thêm sản phẩm"
                            style="-fx-background-color: #0F172A; -fx-text-fill: white;
                                   -fx-background-radius: 10; -fx-font-size: 13px;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 18;"/>
                    <Button onAction="#handleEditProduct" text="✏  Sửa"
                            style="-fx-background-color: #EFF6FF; -fx-text-fill: #1D4ED8;
                                   -fx-border-color: #BFDBFE; -fx-border-radius: 10;
                                   -fx-background-radius: 10; -fx-font-size: 13px;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 18;"/>
                    <Button onAction="#handleDeleteProduct" text="🗑  Xóa"
                            style="-fx-background-color: #FEF2F2; -fx-text-fill: #EF4444;
                                   -fx-border-color: #FCA5A5; -fx-border-radius: 10;
                                   -fx-background-radius: 10; -fx-font-size: 13px;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 18;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#handleStartAuction" text="🔨  Bắt đầu đấu giá"
                            style="-fx-background-color: #ECFDF5; -fx-text-fill: #059669;
                                   -fx-border-color: #6EE7B7; -fx-border-radius: 10;
                                   -fx-background-radius: 10; -fx-font-size: 13px;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 18;"/>
                    <Button onAction="#handleCancelAuction" text="🚫  Hủy phiên"
                            style="-fx-background-color: #FEF2F2; -fx-text-fill: #EF4444;
                                   -fx-border-color: #FCA5A5; -fx-border-radius: 10;
                                   -fx-background-radius: 10; -fx-font-size: 13px;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 18;"/>
                </HBox>

                <!-- Table -->
                <TableView fx:id="tableItems" VBox.vgrow="ALWAYS"
                           styleClass="table-view-custom"
                           style="-fx-background-color: white; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colId"     prefWidth="70"  text="ID"/>
                        <TableColumn fx:id="colName"   prefWidth="280" text="Tên sản phẩm"/>
                        <TableColumn fx:id="colPrice"  prefWidth="150" text="Giá hiện tại"/>
                        <TableColumn fx:id="colWinner" prefWidth="160" text="Người dẫn đầu"/>
                        <TableColumn fx:id="colStatus" prefWidth="140" text="Trạng thái"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <!-- ── VIEW 2: BÁO CÁO ─────────────────────── -->
            <VBox fx:id="reportView" visible="false" managed="false" spacing="0">

                <!-- Page header -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 26 30 20 30; -fx-background-color: #F8FAFC;
                             -fx-border-color: transparent transparent #E2E8F0 transparent;
                             -fx-border-width: 1;" spacing="12">
                    <VBox spacing="4">
                        <Label text="Báo cáo doanh thu"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                        <Label text="Thống kê hiệu quả bán hàng và tình hình đấu giá"
                               style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#handleRefreshReport" text="↻  Làm mới"
                            style="-fx-background-color: white; -fx-text-fill: #0F172A;
                                   -fx-border-color: #E2E8F0; -fx-border-radius: 10;
                                   -fx-background-radius: 10; -fx-font-size: 13px;
                                   -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 9 18;"/>
                </HBox>

                <VBox spacing="20" style="-fx-padding: 24 30;">

                    <!-- Stat cards -->
                    <HBox spacing="16">
                        <VBox HBox.hgrow="ALWAYS" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #E2E8F0; -fx-border-radius: 14;
                                     -fx-border-width: 0.5; -fx-padding: 20 22;">
                            <Label text="Tổng sản phẩm"
                                   style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;
                                          -fx-font-weight: bold;"/>
                            <Label fx:id="lblTotalItems" text="0"
                                   style="-fx-font-size: 32px; -fx-font-weight: bold;
                                          -fx-text-fill: #1D4ED8;"/>
                            <Label text="Trong kho hàng"
                                   style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #E2E8F0; -fx-border-radius: 14;
                                     -fx-border-width: 0.5; -fx-padding: 20 22;">
                            <Label text="Đang đấu giá"
                                   style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;
                                          -fx-font-weight: bold;"/>
                            <Label fx:id="lblRunningAuctions" text="0"
                                   style="-fx-font-size: 32px; -fx-font-weight: bold;
                                          -fx-text-fill: #059669;"/>
                            <Label text="Phiên đang hoạt động"
                                   style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="6"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #E2E8F0; -fx-border-radius: 14;
                                     -fx-border-width: 0.5; -fx-padding: 20 22;">
                            <Label text="Đã hoàn thành"
                                   style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;
                                          -fx-font-weight: bold;"/>
                            <Label fx:id="lblFinishedAuctions" text="0"
                                   style="-fx-font-size: 32px; -fx-font-weight: bold;
                                          -fx-text-fill: #B45309;"/>
                            <Label text="Phiên đã kết thúc"
                                   style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="6"
                              style="-fx-background-color: #F0FDF4; -fx-background-radius: 14;
                                     -fx-border-color: #BBF7D0; -fx-border-radius: 14;
                                     -fx-border-width: 1; -fx-padding: 20 22;">
                            <Label text="Tổng doanh thu"
                                   style="-fx-font-size: 12px; -fx-text-fill: #059669;
                                          -fx-font-weight: bold;"/>
                            <Label fx:id="lblTotalRevenue" text="0 đ"
                                   style="-fx-font-size: 24px; -fx-font-weight: bold;
                                          -fx-text-fill: #059669;" wrapText="true"/>
                            <Label text="Theo giá đã kết thúc"
                                   style="-fx-font-size: 11px; -fx-text-fill: #16A34A;"/>
                        </VBox>
                    </HBox>

                    <!-- Charts -->
                    <HBox spacing="16" VBox.vgrow="ALWAYS">
                        <VBox HBox.hgrow="ALWAYS" spacing="12"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #E2E8F0; -fx-border-radius: 14;
                                     -fx-border-width: 0.5; -fx-padding: 20 22;">
                            <Label text="Doanh thu theo sản phẩm"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                                          -fx-text-fill: #0F172A;"/>
                            <BarChart fx:id="revenueBarChart" legendVisible="false"
                                      animated="true" VBox.vgrow="ALWAYS">
                                <xAxis><CategoryAxis label="Sản phẩm"/></xAxis>
                                <yAxis><NumberAxis label="VNĐ"/></yAxis>
                            </BarChart>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="12"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #E2E8F0; -fx-border-radius: 14;
                                     -fx-border-width: 0.5; -fx-padding: 20 22;">
                            <Label text="Tỉ lệ trạng thái phiên"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                                          -fx-text-fill: #0F172A;"/>
                            <PieChart fx:id="statusPieChart" legendVisible="true"
                                      animated="true" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>
