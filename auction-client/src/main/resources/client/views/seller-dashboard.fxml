<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="app-shell" stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controllers.SellerDashboardController">

    <left>
        <VBox prefWidth="260" styleClass="side-panel" spacing="18">
            <padding><Insets top="24" right="18" bottom="24" left="18"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="brand-icon" prefWidth="44" prefHeight="44">
                    <Label text="⚡" style="-fx-font-size: 21px;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="AuctionVN" styleClass="brand-title"/>
                    <Label text="Seller Dashboard" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <VBox styleClass="user-card" spacing="8">
                <Label text="Xin chào người bán" styleClass="muted-small"/>
                <Label fx:id="lblSellerName" text="Seller" styleClass="user-name"/>
                <Label text="● Quản lý gian hàng" styleClass="online-text"/>
            </VBox>

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Button fx:id="btnInventory" maxWidth="Infinity" onAction="#handleShowInventory" text="📦   Kho hàng" styleClass="nav-button-active"/>
                <Button maxWidth="Infinity" onAction="#showAddProductDialog" text="＋   Đăng sản phẩm mới" styleClass="nav-button"/>
                <Button fx:id="btnStartAuction" maxWidth="Infinity" onAction="#handleStartAuction" text="🔨   Tạo phiên đấu giá" styleClass="nav-button"/>
                <Button fx:id="btnReport" maxWidth="Infinity" onAction="#handleShowReport" text="📊   Báo cáo doanh thu" styleClass="nav-button"/>
            </VBox>

            <Button maxWidth="Infinity" onAction="#handleLogout" text="Đăng xuất" styleClass="logout-button"/>
        </VBox>
    </left>

    <center>
        <StackPane styleClass="content-bg">

            <VBox fx:id="inventoryView" spacing="0">
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar">
                    <VBox spacing="3">
                        <Label text="Quản lý kho hàng" styleClass="page-title"/>
                        <Label text="Theo dõi sản phẩm, đọc mô tả đầy đủ, tạo phiên đấu giá và xử lý trạng thái" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="↻ Làm mới" onAction="#handleRefreshInventory" styleClass="btn-outline"/>
                    <Button text="＋ Thêm sản phẩm" onAction="#showAddProductDialog" styleClass="btn-primary"/>
                </HBox>

                <ScrollPane fitToWidth="true" fitToHeight="true" pannable="true" VBox.vgrow="ALWAYS" styleClass="clean-scroll page-scroll">
                    <VBox spacing="18">
                        <padding><Insets top="24" right="30" bottom="32" left="30"/></padding>

                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <VBox styleClass="summary-blue-card" spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="TỔNG SẢN PHẨM" styleClass="summary-label"/>
                                <Label fx:id="lblSellerItemsCount" text="0" styleClass="summary-value"/>
                                <Label text="Trong kho hàng" styleClass="summary-desc"/>
                            </VBox>
                            <VBox styleClass="summary-green-card" spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="ĐANG ĐẤU GIÁ" styleClass="summary-label"/>
                                <Label fx:id="lblSellerRunningCount" text="0" styleClass="summary-value"/>
                                <Label text="Phiên còn hoạt động" styleClass="summary-desc"/>
                            </VBox>
                            <VBox styleClass="summary-purple-card" spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="DOANH THU" styleClass="summary-label"/>
                                <Label fx:id="lblSellerRevenueMini" text="0 đ" styleClass="summary-value"/>
                                <Label text="Từ phiên đã hoàn tất" styleClass="summary-desc"/>
                            </VBox>
                        </HBox>

                        <VBox styleClass="list-panel" spacing="16" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <TextField fx:id="txtProductSearch" promptText="Tìm mã, tên hoặc mô tả sản phẩm..." onKeyReleased="#handleProductSearch" prefWidth="300" prefHeight="42" styleClass="search-field"/>
                                <ComboBox fx:id="cmbProductStatusFilter" onAction="#handleProductSearch" prefWidth="170" prefHeight="42" styleClass="filter-combo"/>
                                <Button text="Xóa lọc" onAction="#handleClearProductFilter" styleClass="btn-outline"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnEditProduct" onAction="#handleEditProduct" text="✏ Sửa" styleClass="btn-info"/>
                                <Button fx:id="btnDeleteProduct" onAction="#handleDeleteProduct" text="🗑 Xóa" styleClass="btn-danger"/>
                                <Button fx:id="btnCancelAuction" onAction="#handleCancelAuction" text="🚫 Hủy phiên" styleClass="btn-danger"/>
                            </HBox>

                            <HBox spacing="18" VBox.vgrow="ALWAYS">
                                <TableView fx:id="tableItems" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" minHeight="430" styleClass="table-view-custom">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="90" text="ID"/>
                                        <TableColumn fx:id="colName" prefWidth="240" text="Tên sản phẩm"/>
                                        <TableColumn fx:id="colPrice" prefWidth="150" text="Giá hiện tại"/>
                                        <TableColumn fx:id="colWinner" prefWidth="230" text="Thông tin chi tiết"/>
                                        <TableColumn fx:id="colStatus" prefWidth="150" text="Trạng thái"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>

                                <VBox prefWidth="380" minWidth="340" spacing="14" styleClass="seller-inspector-card">
                                    <StackPane minHeight="150" prefHeight="190" styleClass="seller-image-frame">
                                        <ImageView fx:id="sellerProductImage" fitWidth="330" fitHeight="175" preserveRatio="true" smooth="true"/>
                                        <VBox fx:id="sellerProductImagePlaceholder" alignment="CENTER" spacing="6">
                                            <Label text="📦" style="-fx-font-size: 42px;"/>
                                            <Label text="Ảnh sản phẩm" styleClass="text-muted"/>
                                        </VBox>
                                    </StackPane>

                                    <VBox spacing="5">
                                        <Label text="SẢN PHẨM ĐANG CHỌN" styleClass="summary-label"/>
                                        <Label fx:id="lblSelectedProductName" text="Chưa chọn sản phẩm" wrapText="true" styleClass="seller-selected-title"/>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label fx:id="lblSelectedProductId" text="ID: --" styleClass="soft-chip-blue"/>
                                            <Label fx:id="lblSelectedProductCategory" text="--" styleClass="soft-chip-green"/>
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="7" VBox.vgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label text="Mô tả" styleClass="form-label"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Button text="Đọc đầy đủ" onAction="#handleShowSelectedProductDetail" styleClass="text-action-button"/>
                                        </HBox>
                                        <ScrollPane fitToWidth="true" prefViewportHeight="110" minViewportHeight="78" styleClass="description-scroll clean-scroll">
                                            <content>
                                                <Label fx:id="lblSelectedProductDescription" text="Chọn một sản phẩm để xem mô tả, trạng thái phiên và thao tác nhanh." wrapText="true" styleClass="product-description"/>
                                            </content>
                                        </ScrollPane>
                                    </VBox>

                                    <GridPane hgap="10" vgap="10">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="45"/>
                                            <ColumnConstraints percentWidth="55"/>
                                        </columnConstraints>
                                        <Label text="Giá gốc" styleClass="spec-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                        <Label fx:id="lblSelectedProductPrice" text="--" styleClass="spec-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                        <Label text="Trạng thái" styleClass="spec-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                        <Label fx:id="lblSelectedAuctionStatus" text="--" styleClass="spec-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                        <Label text="Giá hiện tại" styleClass="spec-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                        <Label fx:id="lblSelectedAuctionPrice" text="--" styleClass="spec-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                        <Label text="Người dẫn đầu" styleClass="spec-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                        <Label fx:id="lblSelectedAuctionWinner" text="--" styleClass="spec-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                        <Label text="Kết thúc" styleClass="spec-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                        <Label fx:id="lblSelectedAuctionEndTime" text="--" styleClass="spec-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                                    </GridPane>

                                    <VBox spacing="8">
                                        <Button text="📄 Xem đầy đủ thông tin" onAction="#handleShowSelectedProductDetail" maxWidth="Infinity" styleClass="btn-outline"/>
                                        <Button text="🖼 Mở ảnh lớn" onAction="#handleShowSelectedProductImage" maxWidth="Infinity" styleClass="btn-outline"/>
                                        <Button fx:id="btnOpenAuctionRoom" text="👁 Xem phòng đấu giá" onAction="#handleOpenAuctionRoom" maxWidth="Infinity" styleClass="btn-info"/>
                                        <Button fx:id="btnQuickStartAuction" text="🚀 Tạo / đăng lại phiên" onAction="#handleStartAuction" maxWidth="Infinity" styleClass="btn-primary"/>
                                    </VBox>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </VBox>

            <VBox fx:id="reportView" visible="false" managed="false" spacing="0">
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar">
                    <VBox spacing="3">
                        <Label text="Báo cáo doanh thu" styleClass="page-title"/>
                        <Label text="Thống kê hiệu quả bán hàng và tình hình đấu giá" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#handleRefreshReport" text="↻ Làm mới" styleClass="btn-outline"/>
                    <Button onAction="#handleShowInventory" text="← Về kho hàng" styleClass="btn-primary"/>
                </HBox>

                <ScrollPane fitToWidth="true" fitToHeight="true" pannable="true" VBox.vgrow="ALWAYS" styleClass="clean-scroll page-scroll">
                    <VBox spacing="20">
                        <padding><Insets top="24" right="30" bottom="32" left="30"/></padding>

                        <HBox spacing="16">
                            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="stat-blue-card">
                                <Label text="Tổng sản phẩm" styleClass="stat-title"/>
                                <Label fx:id="lblTotalItems" text="0" styleClass="stat-value"/>
                                <Label text="Trong kho hàng" styleClass="stat-subtitle"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="stat-green-card">
                                <Label text="Đang đấu giá" styleClass="stat-title"/>
                                <Label fx:id="lblRunningAuctions" text="0" styleClass="stat-value"/>
                                <Label text="Phiên còn hoạt động" styleClass="stat-subtitle"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="stat-orange-card">
                                <Label text="Đã kết thúc" styleClass="stat-title"/>
                                <Label fx:id="lblFinishedAuctions" text="0" styleClass="stat-value"/>
                                <Label text="Phiên thành công/kết thúc" styleClass="stat-subtitle"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="stat-purple-card">
                                <Label text="Tổng doanh thu" styleClass="stat-title"/>
                                <Label fx:id="lblTotalRevenue" text="0 đ" styleClass="stat-value" wrapText="true"/>
                                <Label text="Từ phiên đã hoàn tất" styleClass="stat-subtitle"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="20" VBox.vgrow="ALWAYS">
                            <VBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" minHeight="420" styleClass="chart-card" spacing="12">
                                <Label text="Doanh thu theo sản phẩm" styleClass="chart-title"/>
                                <BarChart fx:id="revenueBarChart" legendVisible="false" VBox.vgrow="ALWAYS">
                                    <xAxis><CategoryAxis label="Sản phẩm"/></xAxis>
                                    <yAxis><NumberAxis label="VNĐ"/></yAxis>
                                </BarChart>
                            </VBox>

                            <VBox prefWidth="360" VBox.vgrow="ALWAYS" minHeight="420" styleClass="chart-card" spacing="12">
                                <Label text="Tỷ lệ trạng thái" styleClass="chart-title"/>
                                <PieChart fx:id="statusPieChart" legendVisible="true" VBox.vgrow="ALWAYS"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
