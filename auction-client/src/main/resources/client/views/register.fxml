<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="720.0" prefWidth="1120.0" styleClass="auth-bg" stylesheets="@app.css"
           xmlns="http://javafx.com/javafx/17.0.2-ea"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.controllers.RegisterController">

    <HBox maxWidth="1040" maxHeight="640" styleClass="auth-shell">
        <VBox prefWidth="470" alignment="CENTER_LEFT" spacing="28" styleClass="auth-hero-purple">
            <padding><Insets top="56" right="46" bottom="56" left="46"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="brand-icon-large" prefWidth="56" prefHeight="56">
                    <Label text="🚀" style="-fx-font-size: 28px;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="Tham gia AuctionVN" textFill="WHITE"><font><Font name="System Bold" size="30"/></font></Label>
                    <Label text="Bắt đầu mua bán thông minh" styleClass="auth-hero-subtitle"/>
                </VBox>
            </HBox>

            <VBox spacing="10">
                <Label text="Tạo tài khoản\ntrong vài giây" styleClass="auth-hero-title"/>
                <Label text="Người bán có thể đăng sản phẩm và tạo phiên đấu giá. Người mua có thể nạp ví và đặt giá theo thời gian thực." styleClass="auth-hero-desc" wrapText="true"/>
            </VBox>

            <VBox spacing="12">
                <Label text="✓ Tạo sản phẩm và phiên đấu giá" styleClass="auth-feature"/>
                <Label text="✓ Tham gia đấu giá realtime" styleClass="auth-feature"/>
                <Label text="✓ Theo dõi chiến thắng và lịch sử" styleClass="auth-feature"/>
            </VBox>
        </VBox>

        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <VBox alignment="CENTER_LEFT" maxWidth="440" spacing="16" styleClass="auth-card">
                <padding><Insets top="38" right="42" bottom="38" left="42"/></padding>

                <VBox spacing="6">
                    <Label text="Tạo tài khoản" styleClass="auth-title"/>
                    <Label text="Điền thông tin và chọn vai trò sử dụng" styleClass="auth-subtitle"/>
                </VBox>

                <VBox spacing="9">
                    <Label text="Bạn muốn trở thành?" styleClass="form-label"/>
                    <HBox spacing="10" alignment="CENTER">
                        <Button fx:id="btnSeller" onAction="#selectSeller" prefHeight="44" prefWidth="176" text="Người bán" styleClass="role-button"/>
                        <Button fx:id="btnBidder" onAction="#selectBidder" prefHeight="44" prefWidth="176" text="Người mua" styleClass="role-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="8">
                    <Label text="Họ và tên" styleClass="form-label"/>
                    <TextField fx:id="txtFullName" prefHeight="46" promptText="Vd: Nguyễn Văn A" styleClass="input-field"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Tên đăng nhập" styleClass="form-label"/>
                    <TextField fx:id="txtUsername" prefHeight="46" promptText="Vd: nguyenvana123" styleClass="input-field"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Mật khẩu" styleClass="form-label"/>
                    <PasswordField fx:id="txtPassword" prefHeight="46" promptText="Ít nhất 6 ký tự..." styleClass="input-field"/>
                </VBox>

                <Button maxWidth="Infinity" onAction="#handleRegister" prefHeight="50" styleClass="btn-primary" text="ĐĂNG KÝ TÀI KHOẢN"/>

                <HBox alignment="CENTER" spacing="5">
                    <Label text="Đã có tài khoản?" styleClass="text-muted"/>
                    <Hyperlink onAction="#goToLogin" styleClass="hyperlink" text="Đăng nhập"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
