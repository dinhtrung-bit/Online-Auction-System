<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@app.css"
           xmlns="http://javafx.com/javafx/17.0.2-ea"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.controllers.AuctionDetailController">

    <BorderPane styleClass="live-room-bg">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="live-topbar">
                <Button text="← Quay lại" onAction="#handleBackToList" styleClass="live-back-button"/>
                <Separator orientation="VERTICAL" prefHeight="28"/>
                <StackPane prefWidth="40" prefHeight="40" styleClass="live-room-icon">
                    <Label text="⚡"/>
                </StackPane>
                <VBox spacing="2">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="lblRoomTitle" text="Đấu giá trực tiếp" styleClass="live-title"/>
                        <Label fx:id="lblRoomId" text="Phòng #--" styleClass="room-id-pill"/>
                    </HBox>
                    <Label text="Theo dõi sản phẩm, giá, lịch sử và đặt giá trong thời gian thực" styleClass="live-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="↻ Làm mới" onAction="#handleRefreshRoom" styleClass="live-refresh-button"/>
                <Label fx:id="lblStatusBadge" text="● Đang tải" styleClass="live-status-badge"/>
            </HBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="clean-scroll">
                <HBox spacing="18" styleClass="live-room-content">

                    <!-- LEFT: PRODUCT INFO -->
                    <VBox prefWidth="370" spacing="14">
                        <VBox spacing="14" styleClass="live-product-card">
                            <StackPane styleClass="product-image-frame" minHeight="260" prefHeight="300">
                                <ImageView fx:id="imgProduct" fitWidth="340" fitHeight="280" preserveRatio="true" smooth="true"/>
                                <VBox fx:id="paneProductImagePlaceholder" alignment="CENTER" spacing="8" styleClass="product-image-placeholder">
                                    <Label fx:id="lblProductInitial" text="🏺" styleClass="product-placeholder-icon"/>
                                    <Label text="Ảnh sản phẩm" styleClass="product-placeholder-text"/>
                                </VBox>
                                <Label text="ĐANG ĐẤU" styleClass="image-live-ribbon" StackPane.alignment="TOP_LEFT"/>
                            </StackPane>

                            <VBox spacing="8">
                                <Label fx:id="lblProductName" text="Đang tải sản phẩm..." wrapText="true" styleClass="product-name-large"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label fx:id="lblProductCategory" text="Danh mục: --" styleClass="soft-chip-blue"/>
                                    <Label fx:id="lblProductStatus" text="Đang đồng bộ" styleClass="soft-chip-green"/>
                                </HBox>
                            </VBox>

                            <Separator/>

                            <VBox spacing="8" VBox.vgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Mô tả sản phẩm" styleClass="section-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Đọc đầy đủ" onAction="#handleShowProductDetailPopup" styleClass="text-action-button"/>
                                </HBox>
                                <ScrollPane fitToWidth="true" prefViewportHeight="124" minViewportHeight="88" styleClass="description-scroll clean-scroll">
                                    <content>
                                        <Label fx:id="lblProductDescription" text="Chưa có mô tả." wrapText="true" styleClass="product-description"/>
                                    </content>
                                </ScrollPane>
                                <HBox spacing="8" alignment="CENTER_RIGHT">
                                    <Button text="🖼  Xem ảnh lớn" onAction="#handleShowProductImagePopup" styleClass="btn-outline-small"/>
                                    <Button text="📄  Tất cả thông tin" onAction="#handleShowProductDetailPopup" styleClass="btn-outline-small"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <VBox spacing="12" styleClass="live-card">
                            <Label text="Thông số &amp; hồ sơ" styleClass="section-title"/>
                            <GridPane hgap="12" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="39"/>
                                    <ColumnConstraints percentWidth="61"/>
                                </columnConstraints>
                                <Label text="Mã sản phẩm" styleClass="spec-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Label fx:id="lblProductId" text="--" styleClass="spec-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Giá khởi điểm" styleClass="spec-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <Label fx:id="lblProductStartingPrice" text="--" styleClass="spec-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="Bước đề xuất" styleClass="spec-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <Label fx:id="lblBidStep" text="--" styleClass="spec-value" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                <Label text="Người bán" styleClass="spec-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <Label fx:id="lblSellerInfo" text="--" styleClass="spec-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                <Label text="Bắt đầu" styleClass="spec-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                <Label fx:id="lblAuctionStartTime" text="--" styleClass="spec-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                                <Label text="Kết thúc" styleClass="spec-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                <Label fx:id="lblAuctionEndTime" text="--" styleClass="spec-value" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                            </GridPane>
                        </VBox>
                    </VBox>

                    <!-- CENTER: BIDDING + CHART -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS" minWidth="560">
                        <HBox spacing="14">
                            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="8" styleClass="current-price-hero">
                                <Label text="GIÁ HIỆN TẠI" styleClass="hero-kicker"/>
                                <Label fx:id="lblCurrentPrice" text="---" styleClass="hero-price"/>
                                <HBox alignment="CENTER" spacing="8">
                                    <Label text="👑"/>
                                    <Label fx:id="lblWinner" text="Người dẫn đầu: --" styleClass="hero-winner"/>
                                </HBox>
                            </VBox>

                            <VBox prefWidth="250" spacing="10" styleClass="timer-hero">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="⏱" styleClass="timer-icon"/>
                                    <VBox spacing="1">
                                        <Label text="THỜI GIAN CÒN LẠI" styleClass="timer-kicker"/>
                                        <Label fx:id="lblTimeHint" text="Đồng bộ từ server" styleClass="timer-hint"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="lblTimer" text="--:--:--" styleClass="timer-number"/>
                                <ProgressBar fx:id="timerProgress" progress="0" maxWidth="Infinity" styleClass="timer-progress"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="12">
                            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="mini-stat-card">
                                <Label text="Giá đề xuất tiếp theo" styleClass="mini-stat-label"/>
                                <Label fx:id="lblSuggestedBid" text="--" styleClass="mini-stat-value-blue"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="mini-stat-card">
                                <Label text="Tổng lượt đặt" styleClass="mini-stat-label"/>
                                <Label fx:id="lblTotalBidCount" text="0" styleClass="mini-stat-value"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="mini-stat-card">
                                <Label text="Người tham gia" styleClass="mini-stat-label"/>
                                <Label fx:id="lblParticipantCount" text="0" styleClass="mini-stat-value-green"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" spacing="6" styleClass="mini-stat-card">
                                <Label text="Giá dẫn đầu" styleClass="mini-stat-label"/>
                                <Label fx:id="lblLeaderPrice" text="--" styleClass="mini-stat-value-orange"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="14" styleClass="bid-panel">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🚀 Đặt giá nhanh" styleClass="section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Nhấn Enter trong ô nhập để đặt giá" styleClass="text-muted"/>
                            </HBox>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="txtBidAmount" promptText="Nhập số tiền bạn muốn đặt..." onAction="#handlePlaceBid" HBox.hgrow="ALWAYS" styleClass="bid-input"/>
                                <Label text="VNĐ" styleClass="currency-pill"/>
                                <Button fx:id="btnPlaceBid" text="🔨 Đặt giá" onAction="#handlePlaceBid" styleClass="place-bid-button"/>
                            </HBox>

                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Tăng nhanh:" styleClass="filter-label"/>
                                <Button text="+500k" onAction="#handleQuickBid" userData="500000" styleClass="quick-bid-button"/>
                                <Button text="+1tr" onAction="#handleQuickBid" userData="1000000" styleClass="quick-bid-button"/>
                                <Button text="+2tr" onAction="#handleQuickBid" userData="2000000" styleClass="quick-bid-button"/>
                                <Button text="+5tr" onAction="#handleQuickBid" userData="5000000" styleClass="quick-bid-button"/>
                                <Button text="Tối thiểu" onAction="#handleUseSuggestedBid" styleClass="quick-bid-button-blue"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnOpenAutoBid" text="🤖 AutoBid" onAction="#handleOpenAutoBidDialog" styleClass="autobid-button"/>
                            </HBox>

                            <HBox fx:id="paneAutoBidActive" spacing="12" alignment="CENTER_LEFT" managed="false" visible="false" styleClass="autobid-active-box">
                                <Label text="🤖" styleClass="autobid-icon"/>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="AutoBid đang hoạt động" styleClass="autobid-title"/>
                                    <Label fx:id="lblAutoBidInfo" text="--" styleClass="autobid-subtitle"/>
                                </VBox>
                                <Button text="Tắt" onAction="#handleCancelAutoBid" styleClass="btn-danger"/>
                            </HBox>
                        </VBox>

                        <HBox spacing="14" VBox.vgrow="ALWAYS">
                            <VBox HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" spacing="10" styleClass="live-card">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="📈 Biểu đồ giá" styleClass="section-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="Realtime" styleClass="soft-chip-blue"/>
                                </HBox>
                                <LineChart fx:id="bidHistoryChart" animated="true" legendVisible="false" VBox.vgrow="ALWAYS" styleClass="price-chart">
                                    <xAxis><CategoryAxis label="Lượt đặt" animated="false"/></xAxis>
                                    <yAxis><NumberAxis label="VNĐ" animated="false"/></yAxis>
                                </LineChart>
                            </VBox>

                            <VBox prefWidth="360" VBox.vgrow="ALWAYS" spacing="10" styleClass="live-card">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="📋 Lịch sử đặt giá" styleClass="section-title"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblLeaderName" text="--" styleClass="soft-chip-green"/>
                                    <Button text="Mở rộng" onAction="#handleShowFullBidHistory" styleClass="text-action-button"/>
                                </HBox>
                                <ListView fx:id="historyList" VBox.vgrow="ALWAYS" styleClass="history-list"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- RIGHT: USER + MY BIDS -->
                    <VBox prefWidth="300" spacing="14">
                        <VBox spacing="16" styleClass="profile-live-card">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label fx:id="lblAvatar" text="??" styleClass="avatar-large"/>
                                <VBox spacing="3" HBox.hgrow="ALWAYS">
                                    <HBox spacing="6" alignment="CENTER_LEFT">
                                        <Label fx:id="lblProfileName" text="--" styleClass="profile-name"/>
                                        <Label text="Bạn" styleClass="you-pill"/>
                                    </HBox>
                                    <Label fx:id="lblProfileRole" text="Người đấu giá" styleClass="profile-role"/>
                                </VBox>
                            </HBox>

                            <GridPane hgap="10" vgap="10">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>
                                <VBox spacing="4" styleClass="user-metric-green" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                    <Label text="Số dư" styleClass="user-metric-label"/>
                                    <Label fx:id="lblProfileBalance" text="--" wrapText="true" styleClass="user-metric-money"/>
                                </VBox>
                                <VBox spacing="4" styleClass="user-metric-blue" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                    <Label text="Lần bid" styleClass="user-metric-label"/>
                                    <Label fx:id="lblProfileBidCount" text="0" styleClass="user-metric-number"/>
                                </VBox>
                                <VBox spacing="4" styleClass="user-metric-orange" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                    <Label text="Đã thắng" styleClass="user-metric-label"/>
                                    <Label fx:id="lblProfileWins" text="--" styleClass="user-metric-number"/>
                                </VBox>
                                <VBox spacing="4" styleClass="user-metric-purple" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                    <Label text="Win rate" styleClass="user-metric-label"/>
                                    <Label fx:id="lblProfileWinRate" text="--" styleClass="user-metric-number"/>
                                </VBox>
                            </GridPane>

                            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="rank-box">
                                <Label fx:id="lblRankIcon" text="🥉" styleClass="rank-icon"/>
                                <VBox spacing="2">
                                    <Label fx:id="lblRankTitle" text="Đang tải..." styleClass="rank-title"/>
                                    <Label fx:id="lblRankSub" text="" styleClass="rank-subtitle"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox spacing="12" VBox.vgrow="ALWAYS" styleClass="live-card">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="🧾 Bid của tôi" styleClass="section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblMyBestBid" text="" styleClass="soft-chip-green"/>
                                <Button text="Mở rộng" onAction="#handleShowMyBidHistory" styleClass="text-action-button"/>
                            </HBox>
                            <ListView fx:id="myBidHistoryList" VBox.vgrow="ALWAYS" styleClass="my-bid-list"/>
                        </VBox>
                    </VBox>
                </HBox>
            </ScrollPane>
        </center>
    </BorderPane>

    <VBox fx:id="overlayFinished" visible="false" alignment="CENTER" styleClass="finished-overlay">
        <VBox alignment="CENTER" spacing="18" maxWidth="520" styleClass="finished-card">
            <Label fx:id="lblFinishIcon" text="🏆" styleClass="finish-icon"/>
            <Label fx:id="lblFinishTitle" text="CHÚC MỪNG!" styleClass="finish-title"/>
            <Label fx:id="lblFinishMessage" text="Đang tải..." wrapText="true" alignment="CENTER" styleClass="finish-message"/>
            <Button text="Về danh sách" onAction="#handleBackToList" styleClass="place-bid-button"/>
        </VBox>
    </VBox>
</StackPane>
