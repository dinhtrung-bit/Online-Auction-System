<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@app.css"
           xmlns="http://javafx.com/javafx/17.0.2-ea"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.controllers.AuctionListController">

    <VBox styleClass="main-bg" spacing="0">

        <!-- ── TOP NAVIGATION BAR ─────────────────────────── -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #0F172A; -fx-padding: 0 28;">
            <padding><Insets top="14" bottom="14"/></padding>

            <!-- Logo / Brand -->
            <Label text="⚡"  style="-fx-font-size: 20px;"/>
            <Label text="AuctionVN"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Số dư -->
            <Label fx:id="lblBalance" text="💳 Số dư: --"
                   style="-fx-font-size: 13px; -fx-font-weight: bold;
                          -fx-text-fill: #34D399; -fx-padding: 6 14;
                          -fx-background-color: #064E3B;
                          -fx-background-radius: 20;"/>

            <!-- Nạp tiền -->
            <Button text="💰 Nạp tiền" onAction="#handleDeposit"
                    style="-fx-background-color: #10B981; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-font-size: 13px;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-padding: 7 16;"/>

            <!-- Đăng xuất -->
            <Button text="Đăng xuất" onAction="#handleLogout"
                    style="-fx-background-color: #1E293B; -fx-text-fill: #94A3B8;
                           -fx-border-color: #334155; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-font-size: 13px;
                           -fx-cursor: hand; -fx-padding: 7 16;"/>
        </HBox>

        <!-- ── TABS + FILTER BAR ──────────────────────────── -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #F8FAFC;
                     -fx-border-color: transparent transparent #E2E8F0 transparent;
                     -fx-border-width: 1; -fx-padding: 14 28;">

            <!-- Tab buttons -->
            <ToggleButton fx:id="btnTabLive" text="🔥  Đang đấu giá"
                          selected="true" onAction="#switchTab"
                          style="-fx-background-color: #0F172A; -fx-text-fill: white;
                                 -fx-font-weight: bold; -fx-font-size: 13px;
                                 -fx-background-radius: 10; -fx-cursor: hand;
                                 -fx-padding: 8 20;"/>
            <ToggleButton fx:id="btnTabWon" text="🏆  Đã thắng"
                          onAction="#switchTab"
                          style="-fx-background-color: #F1F5F9;
                                 -fx-text-fill: #475569;
                                 -fx-font-weight: bold; -fx-font-size: 13px;
                                 -fx-background-radius: 10; -fx-cursor: hand;
                                 -fx-padding: 8 20;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Filter theo trạng thái -->
            <Label text="Lọc:"
                   style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
            <ComboBox fx:id="cmbStatus" onAction="#handleFilterByStatus"
                      prefWidth="160" prefHeight="36"
                      style="-fx-font-size: 13px; -fx-background-radius: 8;
                             -fx-border-radius: 8; -fx-border-color: #CBD5E1;"/>
        </HBox>

        <!-- ── MAIN CONTENT: danh sách phiên đấu giá ──────── -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <VBox fx:id="auctionContainer" spacing="16"
                  style="-fx-background-color: transparent;">
                <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>
                <!-- Cards được thêm động bằng Java -->
            </VBox>
        </ScrollPane>

    </VBox>

</StackPane>
