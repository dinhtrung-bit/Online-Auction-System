<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<BorderPane styleClass="main-bg"
            stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controllers.AdminDashboardController">

    <left>
        <VBox prefWidth="250.0" style="-fx-background-color: #0f172a;">
            <padding><Insets top="20.0" bottom="20.0"/></padding>

            <Label text="AuctionVN Admin" textFill="WHITE">
                <font><Font name="System Bold" size="22.0"/></font>
                <VBox.margin><Insets bottom="30.0" left="20.0" right="20.0"/></VBox.margin>
            </Label>

            <Button fx:id="btnOverview" maxWidth="Infinity" text="📊 Tổng quan hệ thống"
                    onAction="#showOverview" styleClass="sidebar-btn, sidebar-btn-active"/>

            <Button fx:id="btnUsers" maxWidth="Infinity" text="👥 Quản lý người dùng"
                    onAction="#showUsers" styleClass="sidebar-btn"/>

            <Button fx:id="btnAuctions" maxWidth="Infinity" text="⚖️ Kiểm duyệt phiên đấu"
                    onAction="#showAuctions" styleClass="sidebar-btn"/>

            <Button fx:id="btnSettings" maxWidth="Infinity" text="⚙️ Cài đặt hệ thống"
                    onAction="#showSettings" styleClass="sidebar-btn"/>

            <Pane VBox.vgrow="ALWAYS"/>

            <Button maxWidth="Infinity" text="🚪 Đăng xuất"
                    onAction="#handleLogout"
                    styleClass="sidebar-btn"
                    style="-fx-text-fill: #ef4444;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/></padding>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblPageTitle" text="Tổng quan hệ thống">
                    <font><Font name="System Bold" size="24.0"/></font>
                </Label>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="Tải lại dữ liệu"
                        onAction="#handleReload"
                        styleClass="btn-outline"
                        style="-fx-padding: 8 15;"/>
            </HBox>

            <HBox fx:id="statsBox" spacing="20.0">
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Tổng người dùng" styleClass="text-muted"/>
                    <Label fx:id="lblTotalUsers" text="0" textFill="#2563eb">
                        <font><Font name="System Bold" size="24.0"/></font>
                    </Label>
                    <Label text="Dữ liệu lấy trực tiếp từ DB"
                           style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                </VBox>

                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Tổng sản phẩm" styleClass="text-muted"/>
                    <Label fx:id="lblTotalItems" text="0" textFill="#ef4444">
                        <font><Font name="System Bold" size="24.0"/></font>
                    </Label>
                    <Label text="Sản phẩm trong hệ thống"
                           style="-fx-text-fill: #ef4444; -fx-font-size: 11px;"/>
                </VBox>

                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Tổng doanh thu phí sàn" styleClass="text-muted"/>
                    <Label fx:id="lblRevenue" text="0 đ" textFill="#10b981">
                        <font><Font name="System Bold" size="24.0"/></font>
                    </Label>
                    <Label text="Tính từ phiên đã thanh toán"
                           style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

            <HBox fx:id="filterBox" spacing="12.0" alignment="CENTER_LEFT">
                <Label fx:id="lblTableTitle" text="Danh sách người dùng mới nhất">
                    <font><Font name="System Bold" size="16.0"/></font>
                </Label>

                <Pane HBox.hgrow="ALWAYS"/>

                <TextField fx:id="txtSearchUser"
                           promptText="Tìm username..."
                           onKeyReleased="#handleSearchUser"
                           prefWidth="220"
                           styleClass="input-field"/>

                <ComboBox fx:id="cmbRoleFilter"
                          prefWidth="150"
                          onAction="#handleSearchUser"
                          styleClass="input-field">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="TẤT CẢ"/>
                            <String fx:value="ADMIN"/>
                            <String fx:value="SELLER"/>
                            <String fx:value="BIDDER"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <Button text="Xóa lọc" onAction="#handleClearUserFilter" styleClass="btn-outline"/>
            </HBox>

            <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS" styleClass="table-view-custom">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colUsername" text="Tên đăng nhập" prefWidth="250"/>
                    <TableColumn fx:id="colRole" text="Vai trò" prefWidth="150"/>
                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <TableView fx:id="tableAuctions"
                       VBox.vgrow="ALWAYS"
                       styleClass="table-view-custom"
                       visible="false"
                       managed="false">
                <columns>
                    <TableColumn fx:id="colAuctionId" text="ID phiên" prefWidth="80"/>
                    <TableColumn fx:id="colAuctionItem" text="Tên sản phẩm" prefWidth="250"/>
                    <TableColumn fx:id="colAuctionPrice" text="Giá hiện tại" prefWidth="150"/>
                    <TableColumn fx:id="colAuctionWinner" text="Người dẫn đầu" prefWidth="150"/>
                    <TableColumn fx:id="colAuctionStatus" text="Trạng thái" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <VBox fx:id="settingsPane"
                  visible="false"
                  managed="false"
                  spacing="18.0"
                  styleClass="card"
                  VBox.vgrow="ALWAYS">

                <Label text="⚙️ Thiết lập vận hành hệ thống">
                    <font><Font name="System Bold" size="20.0"/></font>
                </Label>

                <HBox spacing="18.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Phí sàn (%)" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtPlatformFee" promptText="Ví dụ: 5" styleClass="input-field"/>
                    </VBox>

                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Giới hạn nạp tiền (VNĐ)" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtDepositLimit" promptText="Ví dụ: 100000000" styleClass="input-field"/>
                    </VBox>

                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Thời gian đấu giá mặc định (phút)" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="txtDefaultDuration" promptText="Ví dụ: 30" styleClass="input-field"/>
                    </VBox>
                </HBox>

                <Label fx:id="lblSettingMessage"
                       text="Các thiết lập này dùng để demo khả năng mở rộng hệ thống."
                       style="-fx-text-fill: #64748b;"/>

                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <Button text="Đặt mặc định" onAction="#handleResetSettings" styleClass="btn-outline"/>
                    <Button text="💾 Lưu cài đặt" onAction="#handleSaveSettings" styleClass="btn-primary"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>