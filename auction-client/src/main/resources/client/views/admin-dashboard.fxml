<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<BorderPane styleClass="main-bg" stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controllers.AdminDashboardController">

    <!-- ══════════════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="240" spacing="4"
              style="-fx-background-color: #0F172A; -fx-padding: 0 0 20 0;">

            <!-- Brand -->
            <VBox style="-fx-padding: 24 20 20 20;
                         -fx-border-color: transparent transparent #1E293B transparent;
                         -fx-border-width: 1;" spacing="3">
                <Label text="⚡ AuctionVN"
                       style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Admin Dashboard"
                       style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
            </VBox>

            <!-- Nav -->
            <VBox spacing="2" style="-fx-padding: 12 10 0 10;">
                <Button fx:id="btnOverview" maxWidth="Infinity" text="📊  Tổng quan"
                        onAction="#showOverview" styleClass="sidebar-btn sidebar-btn-active"/>
                <Button fx:id="btnUsers" maxWidth="Infinity" text="👥  Người dùng"
                        onAction="#showUsers" styleClass="sidebar-btn"/>
                <Button fx:id="btnAuctions" maxWidth="Infinity" text="⚖  Phiên đấu giá"
                        onAction="#showAuctions" styleClass="sidebar-btn"/>
                <Button fx:id="btnSettings" maxWidth="Infinity" text="⚙  Cài đặt"
                        onAction="#showSettings" styleClass="sidebar-btn"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox style="-fx-padding: 0 10;">
                <Button maxWidth="Infinity" onAction="#handleLogout" text="→  Đăng xuất"
                        styleClass="sidebar-btn"
                        style="-fx-text-fill: #EF4444; -fx-background-color: transparent;
                               -fx-alignment: center-left; -fx-padding: 12 20;
                               -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-background-radius: 10;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════
         MAIN CONTENT
    ══════════════════════════════════════════════ -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #F8FAFC;">

            <!-- Page header -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding: 24 30 18 30; -fx-background-color: #F8FAFC;
                         -fx-border-color: transparent transparent #E2E8F0 transparent;
                         -fx-border-width: 1;">
                <Label fx:id="lblPageTitle" text="Tổng quan hệ thống"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="↻  Tải lại" onAction="#handleReload"
                        style="-fx-background-color: white; -fx-text-fill: #0F172A;
                               -fx-border-color: #E2E8F0; -fx-border-radius: 10;
                               -fx-background-radius: 10; -fx-font-size: 13px;
                               -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;"/>
            </HBox>

            <VBox spacing="18" style="-fx-padding: 22 30 30 30;" VBox.vgrow="ALWAYS">

                <!-- Stat cards -->
                <HBox spacing="16">
                    <VBox HBox.hgrow="ALWAYS" spacing="6"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-border-color: #E2E8F0; -fx-border-radius: 14;
                                 -fx-border-width: 0.5; -fx-padding: 20 22;">
                        <Label text="Tổng người dùng"
                               style="-fx-font-size: 12px; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalUsers" text="0"
                               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #1D4ED8;"/>
                        <Label text="Tài khoản đã đăng ký"
                               style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="6"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-border-color: #E2E8F0; -fx-border-radius: 14;
                                 -fx-border-width: 0.5; -fx-padding: 20 22;">
                        <Label text="Tổng sản phẩm"
                               style="-fx-font-size: 12px; -fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalItems" text="0"
                               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #B45309;"/>
                        <Label text="Sản phẩm trong hệ thống"
                               style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="6"
                          style="-fx-background-color: #F0FDF4; -fx-background-radius: 14;
                                 -fx-border-color: #BBF7D0; -fx-border-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20 22;">
                        <Label text="Doanh thu phí sàn"
                               style="-fx-font-size: 12px; -fx-text-fill: #059669; -fx-font-weight: bold;"/>
                        <Label fx:id="lblRevenue" text="0 đ"
                               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #059669;"
                               wrapText="true"/>
                        <Label text="Từ phiên đã thanh toán"
                               style="-fx-font-size: 11px; -fx-text-fill: #16A34A;"/>
                    </VBox>
                </HBox>

                <!-- Filter bar (dùng chung cho user + auction table) -->
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="lblTableTitle" text="Danh sách người dùng"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtSearchUser" promptText="Tìm username..."
                               onKeyReleased="#handleSearchUser" prefWidth="210"
                               style="-fx-background-color: white; -fx-border-color: #E2E8F0;
                                      -fx-border-radius: 10; -fx-background-radius: 10;
                                      -fx-padding: 8 14; -fx-font-size: 13px;"/>
                    <ComboBox fx:id="cmbRoleFilter" prefWidth="140" onAction="#handleSearchUser"
                              style="-fx-background-color: white; -fx-border-color: #E2E8F0;
                                     -fx-border-radius: 10; -fx-background-radius: 10;
                                     -fx-font-size: 13px;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="TẤT CẢ"/>
                                <String fx:value="ADMIN"/>
                                <String fx:value="SELLER"/>
                                <String fx:value="BIDDER"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                    <Button text="Xóa lọc" onAction="#handleClearUserFilter"
                            style="-fx-background-color: white; -fx-text-fill: #64748B;
                                   -fx-border-color: #E2E8F0; -fx-border-radius: 10;
                                   -fx-background-radius: 10; -fx-font-size: 13px;
                                   -fx-cursor: hand; -fx-padding: 8 16;"/>
                </HBox>

                <!-- User table -->
                <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS"
                           styleClass="table-view-custom"
                           style="-fx-background-color: white; -fx-background-radius: 14;
                                  -fx-border-color: #E2E8F0; -fx-border-radius: 14;">
                    <columns>
                        <TableColumn fx:id="colId"       text="ID"           prefWidth="80"/>
                        <TableColumn fx:id="colUsername" text="Tên đăng nhập" prefWidth="260"/>
                        <TableColumn fx:id="colRole"     text="Vai trò"       prefWidth="150"/>
                        <TableColumn fx:id="colStatus"   text="Trạng thái"    prefWidth="140"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <!-- Auction table (hidden by default) -->
                <TableView fx:id="tableAuctions" VBox.vgrow="ALWAYS"
                           styleClass="table-view-custom"
                           style="-fx-background-color: white; -fx-background-radius: 14;
                                  -fx-border-color: #E2E8F0; -fx-border-radius: 14;"
                           visible="false" managed="false">
                    <columns>
                        <TableColumn fx:id="colAuctionId"     text="ID"             prefWidth="70"/>
                        <TableColumn fx:id="colAuctionItem"   text="Sản phẩm"        prefWidth="240"/>
                        <TableColumn fx:id="colAuctionPrice"  text="Giá hiện tại"    prefWidth="150"/>
                        <TableColumn fx:id="colAuctionWinner" text="Người dẫn đầu"   prefWidth="150"/>
                        <TableColumn fx:id="colAuctionStatus" text="Trạng thái"      prefWidth="130"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <!-- Settings pane (hidden by default) -->
                <VBox fx:id="settingsPane" visible="false" managed="false" spacing="22"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-border-color: #E2E8F0; -fx-border-radius: 16;
                             -fx-border-width: 0.5; -fx-padding: 28 30;"
                      VBox.vgrow="ALWAYS">

                    <Label text="Thiết lập vận hành hệ thống"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>

                    <HBox spacing="20">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Phí sàn (%)"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <TextField fx:id="txtPlatformFee" promptText="VD: 5"
                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                              -fx-border-radius: 10; -fx-background-radius: 10;
                                              -fx-padding: 10 14; -fx-font-size: 14px;"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Giới hạn nạp tiền (VNĐ)"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <TextField fx:id="txtDepositLimit" promptText="VD: 100000000"
                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                              -fx-border-radius: 10; -fx-background-radius: 10;
                                              -fx-padding: 10 14; -fx-font-size: 14px;"/>
                        </VBox>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Thời gian mặc định (phút)"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <TextField fx:id="txtDefaultDuration" promptText="VD: 30"
                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0;
                                              -fx-border-radius: 10; -fx-background-radius: 10;
                                              -fx-padding: 10 14; -fx-font-size: 14px;"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="lblSettingMessage"
                           text="Các thiết lập này áp dụng cho phiên làm việc hiện tại."
                           style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Button text="Đặt mặc định" onAction="#handleResetSettings"
                                style="-fx-background-color: white; -fx-text-fill: #64748B;
                                       -fx-border-color: #E2E8F0; -fx-border-radius: 10;
                                       -fx-background-radius: 10; -fx-font-size: 13px;
                                       -fx-cursor: hand; -fx-padding: 10 20;"/>
                        <Button text="💾  Lưu cài đặt" onAction="#handleSaveSettings"
                                style="-fx-background-color: #0F172A; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-font-size: 13px;
                                       -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 24;"/>
                    </HBox>
                </VBox>

            </VBox>
        </VBox>
    </center>
</BorderPane>
