<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="app-shell" stylesheets="@app.css"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.controllers.AdminDashboardController">

    <left>
        <VBox prefWidth="268" styleClass="side-panel" spacing="16">
            <padding><Insets top="24" right="18" bottom="24" left="18"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="brand-icon" prefWidth="44" prefHeight="44">
                    <Label text="⚡" style="-fx-font-size: 21px;"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="AuctionVN" styleClass="brand-title"/>
                    <Label text="Admin Console" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <VBox styleClass="user-card" spacing="8">
                <Label text="Quản trị hệ thống" styleClass="muted-small"/>
                <Label text="Admin" styleClass="user-name"/>
                <Label text="● Online" styleClass="online-text"/>
            </VBox>

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Button fx:id="btnOverview" maxWidth="Infinity" text="📊   Tổng quan" onAction="#showOverview" styleClass="sidebar-btn"/>
                <Button fx:id="btnUsers" maxWidth="Infinity" text="👥   Người dùng" onAction="#showUsers" styleClass="sidebar-btn"/>
                <Button fx:id="btnAuctions" maxWidth="Infinity" text="⚖   Phiên đấu giá" onAction="#showAuctions" styleClass="sidebar-btn"/>
                <Button fx:id="btnSettings" maxWidth="Infinity" text="⚙   Cài đặt" onAction="#showSettings" styleClass="sidebar-btn"/>
            </VBox>

            <Button maxWidth="Infinity" onAction="#handleLogout" text="Đăng xuất" styleClass="logout-button"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content-bg" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="topbar">
                <VBox spacing="3">
                    <Label fx:id="lblPageTitle" text="Tổng quan hệ thống" styleClass="page-title"/>
                    <Label text="Quản lý user và kiểm duyệt phiên đấu giá" styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="↻ Tải lại" onAction="#handleReload" styleClass="btn-outline"/>
            </HBox>

            <ScrollPane fitToWidth="true" fitToHeight="true" pannable="true" VBox.vgrow="ALWAYS" styleClass="clean-scroll page-scroll">
                <VBox spacing="18">
                    <padding><Insets top="24" right="30" bottom="32" left="30"/></padding>

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox GridPane.columnIndex="0" spacing="6" styleClass="stat-blue-card">
                            <Label text="Tổng người dùng" styleClass="stat-title"/>
                            <Label fx:id="lblTotalUsers" text="0" styleClass="stat-value"/>
                            <Label text="Tài khoản trong hệ thống" styleClass="stat-subtitle"/>
                        </VBox>
                        <VBox GridPane.columnIndex="1" spacing="6" styleClass="stat-orange-card">
                            <Label text="Tổng sản phẩm" styleClass="stat-title"/>
                            <Label fx:id="lblTotalItems" text="0" styleClass="stat-value"/>
                            <Label text="Sản phẩm đã đăng" styleClass="stat-subtitle"/>
                        </VBox>
                    </GridPane>

                    <VBox styleClass="list-panel" spacing="16" VBox.vgrow="ALWAYS">
                        <HBox fx:id="filterBar" spacing="12" alignment="CENTER_LEFT">
                            <Label fx:id="lblTableTitle" text="Danh sách người dùng" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtSearchUser" promptText="Tìm username hoặc ID..." onKeyReleased="#handleSearchUser" prefWidth="230" prefHeight="42" styleClass="search-field"/>
                            <ComboBox fx:id="cmbRoleFilter" prefWidth="150" prefHeight="42" onAction="#handleSearchUser" styleClass="filter-combo"/>
                            <Button text="Xóa lọc" onAction="#handleClearUserFilter" styleClass="btn-outline"/>
                        </HBox>

                        <HBox fx:id="userActionBar" spacing="10" alignment="CENTER_RIGHT">
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="💳 Điều chỉnh ví user" onAction="#handleAdjustSelectedUserBalance" styleClass="btn-outline"/>
                        </HBox>

                        <HBox fx:id="auctionActionBar" spacing="10" alignment="CENTER_RIGHT" visible="false" managed="false">
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🚫 Hủy phiên đã chọn" onAction="#handleCancelSelectedAuction" styleClass="btn-danger"/>
                        </HBox>

                        <TableView fx:id="tableUsers" prefHeight="430" VBox.vgrow="ALWAYS" styleClass="table-view-custom">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                                <TableColumn fx:id="colUsername" text="Tên đăng nhập" prefWidth="230"/>
                                <TableColumn fx:id="colRole" text="Vai trò" prefWidth="130"/>
                                <TableColumn fx:id="colBalance" text="Số dư ví" prefWidth="160"/>
                                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="130"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        </TableView>

                        <TableView fx:id="tableAuctions" prefHeight="430" VBox.vgrow="ALWAYS" styleClass="table-view-custom" visible="false" managed="false">
                            <columns>
                                <TableColumn fx:id="colAuctionId" text="ID" prefWidth="70"/>
                                <TableColumn fx:id="colAuctionItem" text="Sản phẩm" prefWidth="260"/>
                                <TableColumn fx:id="colAuctionPrice" text="Giá hiện tại" prefWidth="150"/>
                                <TableColumn fx:id="colAuctionWinner" text="Người dẫn đầu" prefWidth="150"/>
                                <TableColumn fx:id="colAuctionStatus" text="Trạng thái" prefWidth="130"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        </TableView>

                        <VBox fx:id="settingsPane" visible="false" managed="false" spacing="22" styleClass="card" VBox.vgrow="ALWAYS">
                            <VBox spacing="4">
                                <Label text="Thiết lập vận hành hệ thống" styleClass="section-title"/>
                                <Label text="Các thông số này áp dụng cho phiên làm việc hiện tại." styleClass="text-muted"/>
                            </VBox>
                            <HBox spacing="20">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Phí sàn (%)" styleClass="form-label"/>
                                    <TextField fx:id="txtPlatformFee" promptText="VD: 5" styleClass="input-field"/>
                                </VBox>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Giới hạn nạp tiền (VNĐ)" styleClass="form-label"/>
                                    <TextField fx:id="txtDepositLimit" promptText="VD: 100000000" styleClass="input-field"/>
                                </VBox>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Thời gian mặc định (phút)" styleClass="form-label"/>
                                    <TextField fx:id="txtDefaultDuration" promptText="VD: 30" styleClass="input-field"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="lblSettingMessage" text="Các thiết lập này áp dụng cho phiên làm việc hiện tại." styleClass="text-muted"/>
                            <Region VBox.vgrow="ALWAYS"/>
                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <Button text="Đặt mặc định" onAction="#handleResetSettings" styleClass="btn-outline"/>
                                <Button text="💾 Lưu cài đặt" onAction="#handleSaveSettings" styleClass="btn-primary"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
